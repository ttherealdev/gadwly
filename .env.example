NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Postgres recommended, e.g. Neon/Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/gadwly"
# better-auth
BETTER_AUTH_SECRET="generate-with-openssl-rand--base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com -> OAuth client, redirect:
# http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: override the default Aladhan calculation method (5 = Egyptian General Authority)
NEXT_PUBLIC_PRAYER_CALC_METHOD=5

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# `Authorization` header secret — generate with: openssl rand -base64 32
CRON_SECRET=""
