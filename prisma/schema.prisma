// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  scheduleItems     ScheduleItem[]
  pomodoroLogs      PomodoroSession[]
  examTargets       ExamTarget[]
  preferences       UserPreference?
  pushSubscriptions PushSubscription[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------- App domain ----------

enum ScheduleCategory {
  CENTER
  STUDY
  PROJECT
  SPORT
  REST
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum Weekday {
  SAT
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

// "web" = browser push subscription (p256dh/auth populated, endpoint is the
// real push service URL). "android" = Capacitor/FCM device token (endpoint
// holds the token itself, p256dh/auth are unused).
enum PushPlatform {
  web
  android
}

model ScheduleItem {
  id        String           @id @default(cuid())
  userId    String
  day       Weekday
  title     String
  category  ScheduleCategory
  startTime String
  endTime   String
  status    TaskStatus       @default(PLANNED)
  notes     String?
  color     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, day])
  @@map("schedule_item")
}

model PomodoroSession {
  id        String    @id @default(cuid())
  userId    String
  label     String?
  focusMin  Int
  breakMin  Int
  completed Boolean   @default(false)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@index([userId, startedAt])
  @@map("pomodoro_session")
}

model ExamTarget {
  id         String   @id @default(cuid())
  userId     String
  label      String
  labelKey   String
  targetDate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, userId])
  @@unique([userId, labelKey, targetDate])
  @@index([userId])
  @@map("exam_target")
}

model UserPreference {
  id        String  @id @default(cuid())
  userId    String  @unique
  locale    String  @default("ar") // "ar" | "en"
  latitude  Float?
  longitude Float?
  cityLabel String?

  // Prayer times
  prayerNotifyEnabled Boolean @default(true)
  prayerCalcMethod    Int     @default(5)
  notifyFajr          Boolean @default(true)
  notifyDhuhr         Boolean @default(true)
  notifyAsr           Boolean @default(true)
  notifyMaghrib       Boolean @default(true)
  notifyIsha          Boolean @default(true)

  // Pomodoro
  pomodoroNotifyEnabled Boolean @default(true)

  // Applies to any browser Notification this app shows (distinct from the
  // pomodoro widget's own ambient/chime sound, which stays local to that page).
  notificationSoundOn Boolean @default(true)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

// One row per browser/device the user enabled push notifications on.
// `platform` "web" rows are sent through web-push (VAPID); "android" rows
// are sent through Firebase Admin (FCM), which is what lets the adhan sound
// actually play while the app is fully closed.
model PushSubscription {
  id        String       @id @default(cuid())
  userId    String
  platform  PushPlatform @default(web)
  endpoint  String       @unique // push endpoint URL (web) or FCM token (android)
  p256dh    String?
  auth      String?
  userAgent String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}
